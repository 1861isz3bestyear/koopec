{
  "name": "koopec-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.{ts,json,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"*.{ts,json,html,md}\"",
    "lint": "eslint src --max-warnings 0",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
